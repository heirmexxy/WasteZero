# Copy to .env (npm start loads it). Never commit real keys.
HOST=127.0.0.1
PORT=8787
# true when running behind Caddy or nginx, so visitor addresses come from X-Forwarded-For.
TRUST_PROXY=false

# Admin key for /admin/* (24+ characters, different from any customer key).
WASTEZERO_ADMIN_KEY=replace-with-a-long-random-admin-key-0123456789

# Optional: v0.3-style single customer key. Creates an observe-only "default" customer.
# Prefer creating customers with `npm run tenant -- create "Name"` or POST /admin/tenants.
WASTEZERO_API_KEY=

# ---------------------------------------------------------------- AI providers
# WasteZero picks the provider from the model name (gpt-* → OpenAI, claude-* → Anthropic,
# gemini-* → Gemini, kimi-* → Moonshot, deepseek-* → DeepSeek, "org/model" → OpenRouter),
# or from the X-WasteZero-Provider header. Customers normally send their own key in
# X-Upstream-Authorization. The keys below are WasteZero's own: used for quality tests and
# grading, and for customer traffic when the customer sends no key. Leave unused ones empty.
OPENAI_API_KEY=replace-with-your-openai-api-key
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MOONSHOT_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
# Optional address overrides (defaults are each provider's public API).
OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# Provider used when a model name matches none of the above.
DEFAULT_PROVIDER=openai
# Add any other OpenAI-compatible or Anthropic-compatible provider, e.g. Groq:
# PROVIDERS_JSON={"groq":{"format":"openai","baseUrl":"https://api.groq.com/openai/v1","keyEnv":"GROQ_API_KEY","match":["llama-"]}}

REQUEST_TIMEOUT_MS=45000
MAX_BODY_BYTES=1048576
DATA_DIR=./data
CACHE_MAX_ENTRIES=5000

# USD per 1 million tokens, for every model you serve, from any provider.
#   cachedInput     : price of input read from the provider's prompt cache (falls back to input;
#                     Anthropic models default to 0.1 x input)
#   cacheWriteInput : price of input written to the cache (Anthropic models default to 1.25 x input)
# EXAMPLES ONLY. Check every provider's current price list before billing anyone.
MODEL_RATES_JSON={"gpt-4o-mini":{"input":0.15,"cachedInput":0.075,"output":0.60},"gpt-4o":{"input":2.50,"cachedInput":1.25,"output":10.00},"claude-sonnet-4-5":{"input":3.00,"output":15.00},"claude-haiku-4-5":{"input":1.00,"output":5.00}}

# Which cheaper model the analyser may propose for each expensive one. Both need prices above,
# and both must be at the same provider (routing never crosses providers yet).
DOWNGRADE_MAP_JSON={"gpt-4o":"gpt-4o-mini","claude-sonnet-4-5":"claude-haiku-4-5"}

# Model that grades whether a cheaper answer is an acceptable substitute.
JUDGE_MODEL=gpt-4o-mini

# Autonomous operator. 0 = only when you call POST /admin/operator/run. 3600000 = hourly.
OPERATOR_INTERVAL_MS=0
OPERATOR_ENABLED=true
# Where escalations go (Slack-compatible incoming webhook, or any URL accepting JSON POST).
ESCALATION_WEBHOOK_URL=
# Allowed gap between recorded spend and the provider bill before an invoice needs review.
RECONCILE_TOLERANCE_PCT=5

# ---------------------------------------------------------------- public pages
# The address customers reach this server on (HTTPS in production). Needed for signup,
# card links, unsubscribe links and payment webhooks (<PUBLIC_BASE_URL>/webhooks/payments).
PUBLIC_BASE_URL=
SIGNUP_ENABLED=true
# Secret for signed links. Defaults to one derived from WASTEZERO_ADMIN_KEY.
SIGNING_SECRET=

# ---------------------------------------------------------------- card billing
# none | stripe | paystack
PAYMENT_PROVIDER=none
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
# Currency you charge in, and how many units of it equal 1 USD (fees are computed in USD).
BILLING_CURRENCY=usd
BILLING_FX_RATE=1
# Paystack saves a card with a small charge that is refunded straight away (minor units: 10000 = 100.00).
PAYSTACK_SETUP_AMOUNT_MINOR=10000
# true: invoices are only sent and charged after POST /admin/reconcile against the provider bill.
BILLING_REQUIRE_RECONCILIATION=true
BILLING_AUTO_CHARGE=true
BILLING_MAX_ATTEMPTS=3
BILLING_RETRY_HOURS=72

# ---------------------------------------------------------------- email
# log (writes to data/outbox.jsonl, nothing is sent) | resend
EMAIL_PROVIDER=log
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
SENDER_NAME=WasteZero
# Your postal address. Outreach is not sent without it (anti-spam law requires it).
SENDER_ADDRESS=

# ---------------------------------------------------------------- finding customers
PROSPECTING_ENABLED=false
PROSPECT_QUERIES=LLM,GPT,AI agent,OpenAI API
PROSPECT_MIN_FIT=7
# false: each first email waits for POST /admin/prospects/approve-all (or per prospect).
OUTREACH_AUTO_SEND=false
OUTREACH_DAILY_CAP=20
OUTREACH_FOLLOWUP_DAYS=5
PROSPECT_BATCH_SIZE=10
PROSPECT_DISCOVER_EVERY_HOURS=24
