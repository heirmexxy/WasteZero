# WasteZero runs locally by default. Never commit real keys.
PORT=8787
WASTEZERO_API_KEY=replace-with-a-long-random-client-key
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
REQUEST_TIMEOUT_MS=45000
MAX_BODY_BYTES=1048576
DATA_DIR=./data

# Approximate USD per 1 million tokens. Set rates for the models you use.
# These are examples only; verify current provider prices before use.
MODEL_RATES_JSON={"gpt-4o-mini":{"input":0.15,"output":0.60},"gpt-4o":{"input":2.50,"output":10.00}}
