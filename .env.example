# Copy to .env (npm start loads it). Never commit real keys.
HOST=127.0.0.1
PORT=8787

# Admin key for /admin/* (24+ characters, different from any customer key).
WASTEZERO_ADMIN_KEY=replace-with-a-long-random-admin-key-0123456789

# Optional: v0.3-style single customer key. Creates an observe-only "default" customer.
# Prefer creating customers with `npm run tenant -- create "Name"` or POST /admin/tenants.
WASTEZERO_API_KEY=

# WasteZero's own provider key. Used for quality testing and grading, and for forwarding
# customer traffic when the customer does not send X-Upstream-Authorization.
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1

REQUEST_TIMEOUT_MS=45000
MAX_BODY_BYTES=1048576
DATA_DIR=./data
CACHE_MAX_ENTRIES=5000

# USD per 1 million tokens. cachedInput is the provider's discounted rate for cached prompt
# tokens (falls back to input). Examples only; verify current provider prices before billing.
MODEL_RATES_JSON={"gpt-4o-mini":{"input":0.15,"cachedInput":0.075,"output":0.60},"gpt-4o":{"input":2.50,"cachedInput":1.25,"output":10.00}}

# Which cheaper model the analyser may propose for each expensive one. Both need prices above.
DOWNGRADE_MAP_JSON={"gpt-4o":"gpt-4o-mini"}

# Model that grades whether a cheaper answer is an acceptable substitute.
JUDGE_MODEL=gpt-4o-mini

# Autonomous operator. 0 = only when you call POST /admin/operator/run. 3600000 = hourly.
OPERATOR_INTERVAL_MS=0
OPERATOR_ENABLED=true
# Where escalations go (Slack-compatible incoming webhook, or any URL accepting JSON POST).
ESCALATION_WEBHOOK_URL=
# Allowed gap between recorded spend and the provider bill before an invoice needs review.
RECONCILE_TOLERANCE_PCT=5

# ---------------------------------------------------------------- public pages
# The address customers reach this server on (HTTPS in production). Needed for signup,
# card links, unsubscribe links and payment webhooks (<PUBLIC_BASE_URL>/webhooks/payments).
PUBLIC_BASE_URL=
SIGNUP_ENABLED=true
# Secret for signed links. Defaults to one derived from WASTEZERO_ADMIN_KEY.
SIGNING_SECRET=

# ---------------------------------------------------------------- card billing
# none | stripe | paystack
PAYMENT_PROVIDER=none
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
# Currency you charge in, and how many units of it equal 1 USD (fees are computed in USD).
BILLING_CURRENCY=usd
BILLING_FX_RATE=1
# Paystack saves a card with a small charge that is refunded straight away (minor units: 10000 = 100.00).
PAYSTACK_SETUP_AMOUNT_MINOR=10000
# true: invoices are only sent and charged after POST /admin/reconcile against the provider bill.
BILLING_REQUIRE_RECONCILIATION=true
BILLING_AUTO_CHARGE=true
BILLING_MAX_ATTEMPTS=3
BILLING_RETRY_HOURS=72

# ---------------------------------------------------------------- email
# log (writes to data/outbox.jsonl, nothing is sent) | resend
EMAIL_PROVIDER=log
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
SENDER_NAME=WasteZero
# Your postal address. Outreach is not sent without it (anti-spam law requires it).
SENDER_ADDRESS=

# ---------------------------------------------------------------- finding customers
PROSPECTING_ENABLED=false
PROSPECT_QUERIES=LLM,GPT,AI agent,OpenAI API
PROSPECT_MIN_FIT=7
# false: each first email waits for POST /admin/prospects/approve-all (or per prospect).
OUTREACH_AUTO_SEND=false
OUTREACH_DAILY_CAP=20
OUTREACH_FOLLOWUP_DAYS=5
PROSPECT_BATCH_SIZE=10
PROSPECT_DISCOVER_EVERY_HOURS=24
